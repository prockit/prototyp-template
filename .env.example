# Name shown in the app header
APP_NAME="Prototype"

# SQLite file. Prototypes never use another database.
DATABASE_URL="sqlite:///data/prototype.db"

# Signs the session cookie of the fake login. Any long random value.
SESSION_SECRET="replace-with-a-long-random-value"

# Set to "false" to open the app without the fake login (development only).
AUTH_REQUIRED="true"

# debug | info | warning | error
LOG_LEVEL="info"

# de | en
DEFAULT_LANGUAGE="de"
